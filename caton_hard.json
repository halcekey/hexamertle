      "Contra",
      "hominem",
      "iustum",
      "prave",
      "contendere",
      "noli;"
    ],
    "word_count": 6,
    "elision_count": 2,
    "translation": "Do not try to argue wrongly against a just man;",
    "difficulty": "hard"
  },
  {
    "id": 132,
    "citation": "Disticha Catonis",
    "text": "Quocumque ingrederis sequitur mors corporis umbra.",
    "words": [
      "Quocumque",

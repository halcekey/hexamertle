      "Cumque",
      "reus",
      "tibi",
      "sis,",
      "ipsum",
      "te",
      "iudice",
      "damna."
    ],
    "word_count": 8,
    "elision_count": 1,
    "translation": "When you are the accused, let your own judge be your enemy.",
    "difficulty": "hard"
  },
  {
    "id": 103,
    "citation": "Disticha Catonis",
    "text": "Indulgere gulae noli, quae ventris amica est.",
    "words": [
      "Indulgere",
      "gulae",
      "noli,",
      "quae",
      "ventris",
      "amica",
      "est."
    ],
    "word_count": 7,
    "elision_count": 1,
    "translation": "Do not indulge in gluttony, a friend of the stomach.",
    "difficulty": "hard"
  },
  {
    "id": 104,
    "citation": "Disticha Catonis",
    "text": "Unum praecipue tibi plus hominem esse timendum.",
    "words": [
      "Unum",
      "praecipue",
      "tibi",
      "plus",
      "hominem",
      "esse",
      "timendum."
    ],
    "word_count": 7,
    "elision_count": 1,
    "translation": "One thing above all else you should fear is a man.",
    "difficulty": "hard"
  },
  {
    "id": 106,
    "citation": "Disticha Catonis",
    "text": "Auxilium a notis petito, si forte labores;",
    "words": [
      "Auxilium",
      "a",
      "notis",
      "petito,",
      "si",
      "forte",
      "labores;"
    ],
    "word_count": 7,
    "elision_count": 1,
    "translation": "Seek help from your friends whenyou are in trouble;",
    "difficulty": "hard"
  },
  {
    "id": 107,
    "citation": "Disticha Catonis",
    "text": "Stultitia est morte alterius sperare salutem.",
    "words": [
      "Stultitia",
      "est",
      "morte",
      "alterius",
      "sperare",
      "salutem."
    ],
    "word_count": 6,
    "elision_count": 2,
    "translation": "It is foolish to hope for salvation through the death of another.",
    "difficulty": "hard"
  },
  {
    "id": 108,
    "citation": "Disticha Catonis",
    "text": "Non tibi fortuna est hominis sed vita petenda.",
    "words": [
      "Non",
      "tibi",
      "fortuna",
      "est",
      "hominis",
      "sed",
      "vita",
      "petenda."
    ],
    "word_count": 8,
    "elision_count": 1,
    "translation": "Fortune is not the essence of a man, but the life is.",
    "difficulty": "hard"
  },
  {
    "id": 112,
    "citation": "Disticha Catonis",
    "text": "Ars remanet vitamque hominis non deserit unquam.",
    "words": [
      "Ars",
      "remanet",
      "vitamque",
      "hominis",
      "non",
      "deserit",
      "unquam."
    ],
    "word_count": 7,
    "elision_count": 1,
    "translation": "Skill remains with a man's life and never abandons him.",
    "difficulty": "hard"
  },
  {
    "id": 114,
    "citation": "Disticha Catonis",
    "text": "Sermo hominum mores celat et indicat idem.",
    "words": [
      "Sermo",
      "hominum",
      "mores",
      "celat",
      "et",
      "indicat",
      "idem."
    ],
    "word_count": 7,
    "elision_count": 1,
    "translation": "The speech of men conceals and reveals their character.",
    "difficulty": "hard"
  },
  {
    "id": 117,
    "citation": "Disticha Catonis",
    "text": "Propaganda etenim est rerum doctrina bonarum.",
    "words": [
      "Propaganda",
      "etenim",
      "est",
      "rerum",
      "doctrina",
      "bonarum."
    ],
    "word_count": 6,
    "elision_count": 2,
    "translation": "Propaganda, indeed, is the teaching of good things.",
    "difficulty": "hard"
  },
  {
    "id": 118,
    "citation": "Disticha Catonis",
    "text": "Morbi causa mali nimia est quaecumque voluptas.",
    "words": [
      "Morbi",
      "causa",
      "mali",
      "nimia",
      "est",
      "quaecumque",
      "voluptas."
    ],
    "word_count": 7,
    "elision_count": 1,
    "translation": "Any pleasure, if it is excessive, is a cause of disease.", 
    "difficulty": "hard"
  },
  {
    "id": 124,
    "citation": "Disticha Catonis",
    "text": "Demissos animo et tacitos vitare memento;",
